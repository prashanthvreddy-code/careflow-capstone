# Copy to .env and fill in your own values. Never commit real secrets (.env is git-ignored).
CAPSTONE_DOMAIN=careflow

# LLMs (LiteLLM model names). The fallback model answers when the primary is unavailable.
LLM_MODEL=
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
# Console API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# M7 (optional): Langfuse cloud tracing. Without these, traces go to a local file only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# M8: API key for the FastAPI service (send as header X-API-Key). Generate your own value.
CAREFLOW_API_KEY=

# M8 #4: evaluation judge model (empty = same as LLM_MODEL)
EVAL_JUDGE_MODEL=anthropic/claude-sonnet-5-5
